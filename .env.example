SECRET_KEY=local-dev-only-change-me-to-a-long-random-string-for-local-checks-0123456789
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
# SQLite keeps the quickstart self-contained; point this at a PostgreSQL URL to opt in.
DATABASE_URL=sqlite:///db.sqlite3
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000
